# Application
APP_NAME=AI Job Hunter
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite dev / PostgreSQL prod)
DATABASE_URL=sqlite+aiosqlite:///./ai_job_hunter.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/ai_job_hunter

# Uploads
UPLOAD_DIR=uploads
MAX_CV_SIZE_MB=10

# AI (OpenAI-compatible API)
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@aijobhunter.local

# CORS
FRONTEND_URL=http://localhost:5173

# Matching weights (must sum to 1.0)
MATCH_WEIGHT_SKILLS=0.35
MATCH_WEIGHT_EXPERIENCE=0.20
MATCH_WEIGHT_ROLE=0.20
MATCH_WEIGHT_LOCATION=0.10
MATCH_WEIGHT_EDUCATION=0.05
MATCH_WEIGHT_TECHNOLOGY=0.05
MATCH_WEIGHT_PREFERENCE=0.05

# Scheduler
DEFAULT_SEARCH_INTERVAL_HOURS=6
